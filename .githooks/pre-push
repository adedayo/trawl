#!/usr/bin/env bash
#
# pre-push — the last point at which a known-vulnerable tree is still private.
#
# Placed at push rather than at commit deliberately. A commit is local and
# revertible; a push is the moment work becomes someone else's problem, and it
# is the first moment at which "I'll fix it in a minute" stops being true. A
# commit hook that runs an audit also taxes every single commit for a condition
# that changes only when dependencies do, which is the fastest way to have the
# whole thing disabled.
#
# Only vulnerabilities that reach shipped code block. See scripts/check-vulns.sh
# for why the build toolchain is reported instead.
#
# Bypass with `git push --no-verify`. That is a deliberate escape hatch: a gate
# with no bypass gets removed entirely the first time it is wrong, and a bypass
# that has to be typed is one that leaves a trace in the shell history.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Nothing to check when deleting a remote branch — there is no tree involved.
all_deletes=true
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [[ -z "${local_sha:-}" ]] && continue
  [[ "$local_sha" =~ ^0+$ ]] || all_deletes=false
done
$all_deletes && exit 0

[[ -x "$REPO_ROOT/scripts/check-vulns.sh" ]] || exit 0

printf '\n  Checking dependencies before push...\n'
if ! "$REPO_ROOT/scripts/check-vulns.sh" --quiet; then
  printf '  Push refused. Bypass with: git push --no-verify\n\n'
  exit 1
fi
exit 0
