{
  "name": "trawl",
  "version": "0.1.0",
  "private": true,
  "description": "Continuous external attack surface monitoring and continuous external control validation",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adedayo/trawl.git"
  },
  "scripts": {
    "dev": "npm run dev:app",
    "dev:app": "npm --prefix app run start",
    "build": "npm --prefix app run build",
    "test": "npm --prefix app run test:ci",
    "test:classifier": "vitest run .github/scripts",
    "typecheck": "npm --prefix app run typecheck && npx tsc --noEmit --project tsconfig.json",
    "check": "./test.sh"
  },
  "bugs": {
    "url": "https://github.com/adedayo/trawl/issues"
  },
  "homepage": "https://github.com/adedayo/trawl#readme",
  "devDependencies": {
    "concurrently": "^10.0.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nanoid@<3.3.17": "3.3.18"
  }
}
