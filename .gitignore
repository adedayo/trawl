# Dependencies
node_modules/

# Environment and secrets
.env
.env.local
.env.*.local

# Instance config (real values — only example.json is committed)
config/*.json
!config/example.json

# Build outputs
dist/
.angular/
# Compiled binaries only. These patterns must stay anchored to the repository
# root: unanchored, "trawl" matches the cmd/trawl/ directory and silently
# excludes every source file inside it.
/trawl
/trawl-server

# Wails writes compiled bundles to build/bin, but build/ also holds the icons
# and Info.plist templates the desktop build needs, which must be committed.
build/bin/

# Regenerated by the Wails CLI from wails.json on every build. Committing it
# would freeze the values it exists to interpolate.
build/windows/installer/wails_tools.nsh

# Release staging: checksums, signatures, SBOMs and packages are produced by
# the release workflow and are never committed.
dist-release/
*.dmg
*.AppImage
*.deb
*.rpm
*.pkg
*.msi
SHA256SUMS
*.sig
*.spdx.json

# Windows and Go build products. `*.test` catches binaries left behind by
# `go test -c`; `*.exe` catches cross-compiled Windows builds run locally.
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test

# Signing material. None of this belongs in a repository under any
# circumstances — it lives in CI secrets. Listed explicitly so that an
# accidental `git add -A` after a local signing experiment cannot stage it.
*.p12
*.pfx
*.pem
*.key
*.keychain
*.mobileprovision
*.cer

# Local databases. Trawl's store is a single SQLite file, so a stray dev
# database is an entire organisation's attack-surface inventory sitting in a
# commit. WAL and shared-memory sidecars travel with it.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Local-only multi-repository development. The committed go.mod pins released
# dependencies; go.work is how you build against a sibling checkout without
# making that override part of the module, and therefore part of a release.
go.work
go.work.sum

# Coverage and profiling output
coverage.out
*.cover
*.prof
*.pprof

# Scratch. `tmp_*` is the convention used across these repositories for
# throwaway main packages written while debugging.
tmp_*/
*.log
*.tmp
*.bak
*.orig

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Docker data volumes
data/

# Test results
coverage/
test-results/
playwright-report/

# Build-time staging for the `embed_dashboard` build tag, which compiles the
# Angular bundle into the server binary for single-container deployments.
cmd/trawl/webroot/
