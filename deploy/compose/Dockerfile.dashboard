# Stage 1: Build Angular application
#
# node:24 to match .nvmrc, and not merely for parity: app/package.json declares
# range-scoped `overrides` keys ("pkg@<range>": "version"), which npm 11
# understands and the npm 10 shipped with node:22 does not. Under npm 10 those
# entries resolve differently from the committed lockfile and `npm ci` fails
# with a desync that reproduces nowhere else. deploy/cloudrun/Dockerfile is
# already on node:24, which is why it built while this image did not.
FROM node:24-alpine AS build

WORKDIR /app

COPY app/package*.json ./
RUN npm ci

COPY app/ ./
RUN npm run build -- --configuration=production

# Stage 2: Serve with Nginx
FROM nginx:1.29-alpine

COPY --from=build /app/dist/trawl-app/browser /usr/share/nginx/html
COPY deploy/compose/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
