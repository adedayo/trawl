# Trawl headless server — ingest target, job broker, and read API.
#
# Builds only ./cmd/trawl, which is deliberately free of the Wails desktop
# entrypoint and its embedded frontend, so the server image does not need the
# Angular build to be present.

FROM golang:1.26-alpine AS build

WORKDIR /src

# Pure-Go SQLite (modernc.org/sqlite) means no cgo and no build toolchain.
ENV CGO_ENABLED=0

COPY go.mod go.sum ./
RUN go mod download

COPY cmd/ ./cmd/
COPY pkg/ ./pkg/
# config/ carries the signal registry, which is embedded into the binary at
# compile time. Omitting it does not degrade the build — it fails it.
COPY config/ ./config/

RUN go build -trimpath -ldflags="-s -w" -o /out/trawl-server ./cmd/trawl

FROM alpine:3.21

RUN apk add --no-cache ca-certificates \
    && adduser -D -u 10001 trawl \
    && mkdir -p /data \
    && chown trawl:trawl /data

COPY --from=build /out/trawl-server /usr/local/bin/trawl-server

USER trawl

ENV TRAWL_DB_DSN=/data/trawl.db \
    TRAWL_LISTEN_ADDR=:8080

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
    CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1

ENTRYPOINT ["/usr/local/bin/trawl-server"]
CMD ["server"]
